#!/bin/bash
# Gatito Extractor - NxExtract Custom UI (Gatito Personalizado PT-BR)
# Interface NxExtract com cores e identidade Gatito

NXEXTRACT_VERSION="2.0.0"
SIMS3_RECIPE="$1"
GAME_DIR="$2"
LOG_FILE="${3:-$GAME_DIR/logs/nxextract.log}"
TIMEOUT="${4:-1800}"

# Cores Gatito (paleta invertida do NxExtract)
GATITO_RESET='\033[0m'
GATITO_RED='\033[0;91m'
GATITO_GREEN='\033[0;92m'
GATITO_YELLOW='\033[0;93m'
GATITO_BLUE='\033[0;94m'
GATITO_MAGENTA='\033[0;95m'
GATITO_CYAN='\033[0;96m'
GATITO_WHITE='\033[1;97m'
GATITO_DIM='\033[0;2m'

FILL="${GATITO_MAGENTA}█${GATITO_RESET}"
EMPTY="${GATITO_DIM}░${GATITO_RESET}"

log() {
    local level="$1"
    shift
    local message="$*"
    local timestamp
    timestamp=$(date '+%H:%M:%S')
    case "$level" in
        ERROR) echo -e "${GATITO_RED}[ERRO] [$timestamp] $message${GATITO_RESET}" | tee -a "$LOG_FILE" >&2 ;;
        WARN)  echo -e "${GATITO_YELLOW}[AVISO] [$timestamp] $message${GATITO_RESET}" | tee -a "$LOG_FILE" ;;
        INFO)  echo -e "${GATITO_CYAN}[INFO] [$timestamp] $message${GATITO_RESET}" | tee -a "$LOG_FILE" ;;
        OK)    echo -e "${GATITO_GREEN}[OK] [$timestamp] $message${GATITO_RESET}" | tee -a "$LOG_FILE" ;;
        PROG)  echo -e "$message" ;;
    esac
}

gatito_progress() {
    local current="$1"
    local total="$2"
    local status="$3"
    local width=40
    local percentage=$((current * 100 / total))
    local filled=$((current * width / total))
    local empty=$((width - filled))
    local bar=""
    local i
    for i in $(seq 1 $filled 2>/dev/null); do bar="${bar}${FILL}"; done
    for i in $(seq 1 $empty 2>/dev/null); do bar="${bar}${EMPTY}"; done
    local percentage_text="${GATITO_GREEN}${percentage}%${GATITO_RESET}"
    local status_text="${GATITO_WHITE}${status}${GATITO_RESET}"
    printf "\r\033[K"
    printf "${GATITO_CYAN}[${bar}${GATITO_CYAN}] ${percentage_text} - ${status_text}${GATITO_RESET}"
}

show_phase() {
    local phase_name="$1"
    if [ "$current_phase" -ne 0 ]; then
        printf "\n"
        printf "${GATITO_MAGENTA}╔════════════════════════════════════════════════════════════╗\n"
        printf "║  %s\n" "$phase_name"
        printf "╚════════════════════════════════════════════════════════════╝${GATITO_RESET}\n"
    fi
    current_phase=$((current_phase + 1))
}

draw_header() {
    echo ""
    printf "${GATITO_MAGENTA}╔════════════════════════════════════════════════════════════╗\n"
    printf "║        THE SIMS 3 - EXTRATOR GATITO  (NxExtract)         ║\n"
    printf "║              Interface Personalizada  v%s               ║\n" "$NXEXTRACT_VERSION"
    printf "╚════════════════════════════════════════════════════════════╝${GATITO_RESET}\n"
}

draw_footer() {
    printf "\n${GATITO_DIM}════════════════════════════════════════════════════════════${GATITO_RESET}\n"
}

draw_header
log "INFO" "Extrator Gatito - NxExtract v${NXEXTRACT_VERSION}"
log "INFO" "Receita: ${SIMS3_RECIPE}"
log "INFO" "Diretorio: ${GAME_DIR}"
log "INFO" "Timeout: ${TIMEOUT}s"

export SIMS3_NXEXTRACT_MODE=1
export SIMS3_NXEXTRACT_UI="$0"
export SIMS3_NXEXTRACT_LOG="$LOG_FILE"
export SIMS3_NXEXTRACT_START_TIME
SIMS3_NXEXTRACT_START_TIME=$(date +%s)

NXEXTRACT_WORKSPACE="$GAME_DIR/.gatito-extract"
mkdir -p "$NXEXTRACT_WORKSPACE" "$GAME_DIR/logs" || {
    log "ERROR" "Impossivel criar workspace: $NXEXTRACT_WORKSPACE"
    exit 1
}
log "OK" "Workspace preparado: ${NXEXTRACT_WORKSPACE}"

current_phase=0
show_phase "PREPARANDO O AMBIENTE"
log "PROG" "$(gatito_progress 10 100 "Iniciando preparacao...")"

log "INFO" "Buscando pacotes Android..."
PACKAGES_FOUND=0
PACKAGE_NAMES=()
SEARCH_DIRS="gamedata ."

for search_dir in $SEARCH_DIRS; do
    search_path="$GAME_DIR/$search_dir"
    [ -d "$search_path" ] || continue
    for ext in .apk .apkm .apks .xapk .zip; do
        for pkg in "$search_path"/*"$ext"; do
            [ -f "$pkg" ] && {
                PACKAGES_FOUND=$((PACKAGES_FOUND + 1))
                PACKAGE_NAMES+=("$pkg")
                log "INFO" "Encontrado: $(basename "$pkg")"
            }
        done
    done
    for ext in .obb; do
        for pkg in "$search_path"/*"$ext"; do
            [ -f "$pkg" ] && {
                PACKAGES_FOUND=$((PACKAGES_FOUND + 1))
                PACKAGE_NAMES+=("$pkg")
                log "INFO" "Encontrado: $(basename "$pkg")"
            }
        done
    done
done

if [ "$PACKAGES_FOUND" -eq 0 ]; then
    log "ERROR" "Nenhum pacote Android encontrado em gamedata/ ou ./"
    log "ERROR" "Copie seu APK/OBB do The Sims 3 para gamedata/"
    exit 1
fi

log "PROG" "$(gatito_progress 30 100 "Identificando $PACKAGES_FOUND pacotes...")"
log "OK" "Encontrados $PACKAGES_FOUND pacote(s)"

current_phase=0
show_phase "VALIDANDO DADOS"
log "PROG" "$(gatito_progress 50 100 "Validando entrada...")"

if [ ! -f "$SIMS3_RECIPE" ]; then
    log "ERROR" "Receita nao encontrada: $SIMS3_RECIPE"
    exit 1
fi

RECIPE_NAME=$(basename "$SIMS3_RECIPE")
log "INFO" "Receita carregada: $RECIPE_NAME"
log "OK" "Receita verificada"

current_phase=0
show_phase "EXTRAINDO THE SIMS 3"
log "PROG" "$(gatito_progress 60 100 "Copiando dados do S3E...")"
log "INFO" "Iniciando Gatito Extractor..."
log "PROG" "$(gatito_progress 70 100 "Processando extracao...")"

{
    python3 "$(dirname "$0")/gatito-extract-v3.py" "$SIMS3_RECIPE" \
        --game-dir "$GAME_DIR" \
        2>&1 | while IFS= read -r line; do
        if echo "$line" | grep -q "GATITO_STAGE|"; then
            progress=$(echo "$line" | sed -n 's/.*GATITO_STAGE|\([0-9]*\)|.*/\1/p')
            msg=$(echo "$line" | sed -n 's/.*GATITO_STAGE|[0-9]*|\(.*\)/\1/p')
            gatito_progress "$progress" "100" "$msg"
        else
            echo "$line" | tee -a "$LOG_FILE"
        fi
    done
} > "$LOG_FILE" 2>&1 &
EXTRACT_PID=$!

log "PROG" "$(gatito_progress 80 100 "Extraindo pacotes do Android...")"

monitor_extraction() {
    local extract_pid="$1"
    local timeout_val="$2"
    while kill -0 "$extract_pid" 2>/dev/null; do
        local current_time
        current_time=$(date +%s)
        local elapsed=$((current_time - SIMS3_NXEXTRACT_START_TIME))
        if [ "$elapsed" -ge "$timeout_val" ]; then
            log "ERROR" "Timeout de ${timeout_val}s atingido"
            kill -TERM "$extract_pid" 2>/dev/null
            sleep 5
            kill -KILL "$extract_pid" 2>/dev/null || true
            return 1
        fi
        local elapsed_minutes=$((elapsed / 60))
        local elapsed_seconds=$((elapsed % 60))
        local fill_bar
        fill_bar=$(printf "%${elapsed_minutes}s" "" 2>/dev/null | tr ' ' '█' 2>/dev/null)
        printf "\r\033[K"
        printf "${GATITO_CYAN}[${FILL}%s${EMPTY}] ${GATITO_WHITE}%02d:%02d ${GATITO_DIM}(Tempo decorrido)${GATITO_RESET}" "$fill_bar" "$elapsed_minutes" "$elapsed_seconds"
        sleep 1
    done
    wait "$extract_pid"
    return $?
}

monitor_extraction "$EXTRACT_PID" "$TIMEOUT"
EXTRACT_RC=$?

if [ "$EXTRACT_RC" -ne 0 ]; then
    log "ERROR" "Falha na extracao com codigo: $EXTRACT_RC"
    draw_footer
    exit $EXTRACT_RC
fi

GATE_TIME=$(date +%s)
GATE_DURATION=$((GATE_TIME - SIMS3_NXEXTRACT_START_TIME))

log "PROG" "$(gatito_progress 90 100 "Finalizando extracao...")"
sleep 1

current_phase=0
show_phase "VALIDANDO RESULTADOS"
log "INFO" "Verificando extracao..."

GAME_IMAGE="$GAME_DIR/game/game.s3e.unpacked"
ASSET_DIR="$GAME_DIR/game/assets"
VALIDATED_FILES=0

if [ -f "$GAME_IMAGE" ]; then
    S3E_HEADER=$(od -An -tx1 -N4 "$GAME_IMAGE" 2>/dev/null | tr -d ' \n')
    GAME_SIZE=$(wc -c < "$GAME_IMAGE" 2>/dev/null | tr -d ' ')
    if [ "$S3E_HEADER" != "58453355" ]; then
        log "ERROR" "Header S3E invalido: $S3E_HEADER (esperado: 58453355)"
        exit 1
    fi
    VALIDATED_FILES=$((VALIDATED_FILES + 1))
    log "OK" "Header S3E valido: $S3E_HEADER"
    log "INFO" "Tamanho: ${GAME_SIZE} bytes"
else
    log "ERROR" "Arquivo S3E nao encontrado: $GAME_IMAGE"
    exit 1
fi

if [ -d "$ASSET_DIR" ]; then
    ASSET_COUNT=$(find "$ASSET_DIR" -type f 2>/dev/null | wc -l | tr -d ' ')
    VALIDATED_FILES=$((VALIDATED_FILES + 1))
    log "OK" "Assets validos: $ASSET_COUNT arquivos"
else
    log "ERROR" "Diretorio de assets nao encontrado: $ASSET_DIR"
    exit 1
fi

current_phase=0
show_phase "EXTRACAO CONCLUIDA!"
log "OK" "Extracao concluida com sucesso!"
log "INFO" "Diretorio: $GAME_DIR/game/"
log "INFO" "Imagem: $GAME_IMAGE"
log "INFO" "Assets: $ASSET_DIR"
log "INFO" "Tempo total: ${GATE_DURATION}s"

log "INFO" "Limpando arquivos temporarios..."
rm -rf "$NXEXTRACT_WORKSPACE" >/dev/null 2>&1

draw_footer
echo ""
echo -e "${GATITO_GREEN}╔════════════════════════════════════════════════════════════╗${GATITO_RESET}"
echo -e "${GATITO_GREEN}║       EXTRACAO COMPLETA COM SUCESSO!                     ║${GATITO_RESET}"
echo -e "${GATITO_GREEN}╠════════════════════════════════════════════════════════════╣${GATITO_RESET}"
echo -e "${GATITO_GREEN}║  ${VALIDATED_FILES} itens verificados  |  ${VALIDATED_FILES}/${VALIDATED_FILES} validacoes OK${GATITO_RESET}                     ║"
echo -e "${GATITO_GREEN}║  Controle: $GAME_DIR/run.sh${GATITO_RESET}"
echo -e "${GATITO_GREEN}╚════════════════════════════════════════════════════════════╝${GATITO_RESET}"
echo ""
echo -e "${GATITO_YELLOW}Bem-vindo ao The Sims 3!${GATITO_RESET}"
echo ""
exit 0
